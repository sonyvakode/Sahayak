# GEMINI_API_KEY: Required for server-side Gemini AI calls (Intake, Explanations, Transcription, TTS).
# AI Studio injects this automatically at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="http://localhost:3000"

# SESSION_SECRET: HMAC signing secret for prototype session cookies (defaults to dev secret if unset).
SESSION_SECRET="change-me-in-production"

# SQLITE_DB_PATH: Path to local SQLite database file (defaults to ./sahayakshg.db).
SQLITE_DB_PATH="./sahayakshg.db"

# DATABASE_URL: Optional PostgreSQL connection string for future production migration.
# DATABASE_URL="postgresql://user:password@localhost:5432/sahayakshg"

# Optional External Speech & Agent Orchestration Integrations (Demo fallbacks active when unset)
# BHASHINI_API_KEY=""
# BHASHINI_USER_ID=""
# OPENAI_WHISPER_API_KEY=""
# LYZR_API_KEY=""
# LYZR_WORKFLOW_ID=""
